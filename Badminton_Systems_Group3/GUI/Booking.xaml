<Window x:Class="Badminton_Systems_Group3.GUI.Booking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt sân" Height="710" Width="1130" 
        WindowState="Maximized" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#CDE8F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quản lý Đặt sân" Foreground="White" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text=" 📅" Foreground="White" FontSize="32" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*"/>
                <ColumnDefinition Width="3.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,-18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Danh sách sân" Foreground="#006400" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <UniformGrid Columns="4" VerticalAlignment="Top">

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 01" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 02" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 03" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 04" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 05" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 06" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 07" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F0F0F0" Margin="0,0,0,10">
                                    <Image Source="/Image/sancl.png" Stretch="Uniform"/>
                                </Border>
                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Sân 08" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="120k/h" FontSize="14" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="TRỐNG" FontSize="15" FontWeight="Bold" Foreground="#38A169" Margin="0,0,0,10"/>
                                <Button Content="Đặt sân" Style="{StaticResource ActionButtonStyle}"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </ScrollViewer>
            </Grid>

            <Viewbox Grid.Column="1" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <Border BorderBrush="Gray" BorderThickness="1" Padding="20">
                    <StackPanel Width="360">
                        <TextBlock Text="Thông tin đặt sân" Foreground="#8B0000" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                                <RowDefinition Height="45"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Tên khách hàng:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>

                            <TextBlock Grid.Row="1" Text="SĐT:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>

                            <TextBlock Grid.Row="2" Text="Ngày đặt:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            <DatePicker Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>

                            <TextBlock Grid.Row="3" Text="Giờ bắt đầu:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Height="32" Margin="5" FontSize="16" VerticalContentAlignment="Center" IsEditable="True" Text="11:00 SA">
                                <ComboBoxItem Content="08:00 SA"/>
                                <ComboBoxItem Content="09:00 SA"/>
                                <ComboBoxItem Content="10:00 SA"/>
                                <ComboBoxItem Content="11:00 SA"/>
                            </ComboBox>

                            <TextBlock Grid.Row="4" Text="Giờ kết thúc:" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Height="32" Margin="5" FontSize="16" VerticalContentAlignment="Center" IsEditable="True" Text="13:00 CH">
                                <ComboBoxItem Content="09:00 SA"/>
                                <ComboBoxItem Content="10:00 SA"/>
                                <ComboBoxItem Content="11:00 SA"/>
                                <ComboBoxItem Content="12:00 CH"/>
                                <ComboBoxItem Content="13:00 CH"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel Margin="0,20,0,10">
                            <TextBlock Text="Tổng thời gian:" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Tạm tính:" FontSize="18" FontWeight="Bold" Foreground="Red" Margin="0,0,0,20"/>
                        </StackPanel>

                        <Button Content="XÁC NHẬN ĐẶT SÂN" Style="{StaticResource ConfirmButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Viewbox>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
            </UniformGrid>
        </Border>
    </Grid>
</Window>