<Window x:Class="Badminton_Systems_Group3.GUI.BookingSchedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin lịch đặt" Height="650" Width="1050" 
        WindowStartupLocation="CenterScreen" Background="#F0F0F0" WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="HoverActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="25,20,25,20">
            <TextBlock Text="Thông tin lịch đặt" Foreground="Red" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Trạng thái:" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cbTrangThai" Grid.Column="1" Height="35"
                          VerticalContentAlignment="Center" FontSize="16"
                          SelectedIndex="0" SelectionChanged="cbTrangThai_SelectionChanged">
                    <ComboBoxItem Content="Tất cả"/>
                    <ComboBoxItem Content="Đã đặt"/>
                    <ComboBoxItem Content="Đã thanh toán"/>
                </ComboBox>
                <TextBox x:Name="txtTen" Grid.Column="2" Height="35" Margin="15,0,0,0" VerticalContentAlignment="Center" FontSize="16" KeyDown="txtTen_KeyDown"/>

                <Button x:Name="btnSearch" Grid.Column="2" Height="35" Margin="154,1,31,1" Background="#E0E0E0" Click="BtnSearch_Click">
                    <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="btnCancel" Grid.Column="5" Style="{StaticResource HoverActionBtnStyle}" Click="btnCancel_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✖" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Hủy lịch" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnEdit" Grid.Column="6" Style="{StaticResource HoverActionBtnStyle}" Click="btnEdit_Click" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Thay đổi lịch" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <DatePicker x:Name="dpNgay" Grid.Column="4" HorizontalAlignment="Left" Margin="19,0,0,0" VerticalAlignment="Center" Height="35" Width="67" SelectedDateChanged="dpNgay_SelectedDateChanged"/>
            </Grid>
        </StackPanel>

        <DataGrid x:Name="dgLichDat"
          Grid.Row="1"
          Margin="25,0,25,15"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="False"
          CellEditEnding="dgLichDat_CellEditEnding"
          Background="LightGray"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          FontSize="14">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="Silver"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã đặt sân" Binding="{Binding MaDatSan}" Width="100"/>
                <DataGridTextColumn Header="Tên sân" Binding="{Binding TenSan}" Width="1*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="1*"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="1.5*"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="1*"/>
                <DataGridTextColumn Header="Ngày đặt"
                    Binding="{Binding NgayDat, Mode=TwoWay, StringFormat=dd/MM/yyyy}" />

                <DataGridTextColumn Header="Giờ BĐ"
                    Binding="{Binding GioBD, Mode=TwoWay}" />

                <DataGridTextColumn Header="Giờ KT"
                    Binding="{Binding GioKT, Mode=TwoWay}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Checked="RadioButton_Checked">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton x:Name="btnThongTin" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnThongTin_Click">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

            </UniformGrid>
        </Border>
    </Grid>
</Window>