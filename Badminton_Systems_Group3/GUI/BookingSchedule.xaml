<Window x:Class="Badminton_Systems_Group3.GUI.BookingSchedule"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin lịch đặt - GR3 Badminton" Height="650" Width="1050" 
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="HoverActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="25,20,25,20">
            <TextBlock Text="Thông tin lịch đặt" Foreground="Red" FontSize="28" FontWeight="Bold" Margin="0,0,0,25"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Trạng thái:" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" Height="35" VerticalContentAlignment="Center" FontSize="16"/>
                <TextBox Grid.Column="2" Height="35" Margin="15,0,0,0" VerticalContentAlignment="Center" FontSize="16"/>

                <Button Grid.Column="3" Width="45" Height="35" Margin="8,0,0,0" Background="#E0E0E0">
                    <TextBlock Text="🔍" FontSize="18" VerticalAlignment="Center"/>
                </Button>

                <Button x:Name="btnCancel" Grid.Column="5" Style="{StaticResource HoverActionBtnStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✖" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Hủy lịch" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnEdit" Grid.Column="6" Style="{StaticResource HoverActionBtnStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Thay đổi lịch" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <DataGrid Grid.Row="1" Margin="25,0,25,15" AutoGenerateColumns="False" CanUserAddRows="False" 
                  Background="LightGray" HeadersVisibility="Column" GridLinesVisibility="All" FontSize="14">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="Silver"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã đặt sân" Binding="{Binding MaDatSan}" Width="100"/>
                <DataGridTextColumn Header="Tên sân" Binding="{Binding TenSan}" Width="1*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="1*"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding HoTen}" Width="1.5*"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}" Width="1*"/>
                <DataGridTextColumn Header="Ngày đặt" Binding="{Binding NgayDat}" Width="1*"/>
                <DataGridTextColumn Header="Giờ BĐ" Binding="{Binding GioBD}" Width="1*"/>
                <DataGridTextColumn Header="Giờ KT" Binding="{Binding GioKT}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Background="#004D26">
            <UniformGrid Columns="3">
                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🏠" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Trang chủ" FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Lịch đặt" FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource NavButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thông tin" FontSize="16" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>