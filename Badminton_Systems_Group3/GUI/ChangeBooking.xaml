<Window x:Class="Badminton_Systems_Group3.GUI.ChangeBooking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thay đổi lịch đặt" Height="350" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="CẬP NHẬT LỊCH ĐẶT SÂN" FontSize="20" FontWeight="Bold" Foreground="#024D2A" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Ngày đặt mới:" VerticalAlignment="Center" FontSize="16"/>
            <DatePicker x:Name="dpNgayMoi" Grid.Column="1" Height="30" FontSize="14"/>
        </Grid>

        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Giờ bắt đầu:" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox x:Name="cboGioBD" Grid.Column="1" Height="30" FontSize="14">
                <ComboBoxItem Content="05:00:00"/>
                <ComboBoxItem Content="06:00:00"/>
                <ComboBoxItem Content="07:00:00"/>
                <ComboBoxItem Content="08:00:00"/>
                <ComboBoxItem Content="09:00:00"/>
                <ComboBoxItem Content="10:00:00"/>
                <ComboBoxItem Content="11:00:00"/>
                <ComboBoxItem Content="12:00:00"/>
                <ComboBoxItem Content="13:00:00"/>
                <ComboBoxItem Content="14:00:00"/>
                <ComboBoxItem Content="15:00:00"/>
                <ComboBoxItem Content="16:00:00"/>
                <ComboBoxItem Content="17:00:00"/>
                <ComboBoxItem Content="18:00:00"/>
                <ComboBoxItem Content="19:00:00"/>
                <ComboBoxItem Content="20:00:00"/>
                <ComboBoxItem Content="21:00:00"/>
                <ComboBoxItem Content="22:00:00"/>
            </ComboBox>
        </Grid>

        <Grid Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Giờ kết thúc:" VerticalAlignment="Center" FontSize="16"/>
            <ComboBox x:Name="cboGioKT" Grid.Column="1" Height="30" FontSize="14">
                <ComboBoxItem Content="06:00:00"/>
                <ComboBoxItem Content="07:00:00"/>
                <ComboBoxItem Content="08:00:00"/>
                <ComboBoxItem Content="09:00:00"/>
                <ComboBoxItem Content="10:00:00"/>
                <ComboBoxItem Content="11:00:00"/>
                <ComboBoxItem Content="12:00:00"/>
                <ComboBoxItem Content="13:00:00"/>
                <ComboBoxItem Content="14:00:00"/>
                <ComboBoxItem Content="15:00:00"/>
                <ComboBoxItem Content="16:00:00"/>
                <ComboBoxItem Content="17:00:00"/>
                <ComboBoxItem Content="18:00:00"/>
                <ComboBoxItem Content="19:00:00"/>
                <ComboBoxItem Content="20:00:00"/>
                <ComboBoxItem Content="21:00:00"/>
                <ComboBoxItem Content="22:00:00"/>
                <ComboBoxItem Content="23:00:00"/>
            </ComboBox>
        </Grid>

        <Button x:Name="btnLuu" Content="XÁC NHẬN THAY ĐỔI" Click="btnLuu_Click" 
                Height="40" Background="#1A8CD8" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
    </StackPanel>
</Window>