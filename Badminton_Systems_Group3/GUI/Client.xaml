<Window x:Class="Badminton_Systems_Group3.GUI.Client"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Khách Hàng - GR3 Badminton" 
        WindowState="Maximized" 
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quản lý khách hàng" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text=" 👥" Foreground="White" FontSize="28" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Thông tin khách hàng" Foreground="Red" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Mã KH:" VerticalAlignment="Center" FontSize="15" Margin="0,10"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Height="32" Margin="5,8" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="1" Text="Họ tên:" VerticalAlignment="Center" FontSize="15" Margin="0,10"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="32" Margin="5,8" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Text="SĐT:" VerticalAlignment="Center" FontSize="15" Margin="0,10"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Height="32" Margin="5,8" VerticalContentAlignment="Center"/>
                </Grid>

                <Button Content="➕ Thêm" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="🗑 Xóa" Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="✏ Sửa" Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Danh sách khách hàng" Foreground="Red" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Height="35" VerticalContentAlignment="Center" FontSize="14" Margin="0,2,167,2"/>

                    <Button Content="Tìm kiếm 🔍" Style="{StaticResource ActionButtonStyle}" Padding="20,0" Margin="378,0,0,0"/>
                </Grid>

                <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="#A6A6A6" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                          HeadersVisibility="Column" GridLinesVisibility="All" ColumnWidth="*">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKH}"/>
                        <DataGridTextColumn Header="Họ tên" Width="2*" Binding="{Binding HoTen}"/>
                        <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}"/>
                        <DataGridTextColumn Header="Mã đặt sân" Binding="{Binding MaDatSan}"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">
                <Button Style="{StaticResource FooterButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="🏠" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Trang chủ" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="📅" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Lịch đặt" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterButtonStyle}">
                    <StackPanel>
                        <TextBlock Text="👤" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Thông tin" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>
    </Grid>
</Window>