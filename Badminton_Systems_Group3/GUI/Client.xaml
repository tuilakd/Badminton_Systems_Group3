<Window x:Class="Badminton_Systems_Group3.GUI.Client"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Khách Hàng" 
        WindowState="Maximized" 
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#004D26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="83.797"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quản lý khách hàng" Foreground="White" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text=" 👥" Foreground="White" FontSize="28" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20,20,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Thông tin khách hàng" Foreground="Red" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mã KH -->
                    <TextBlock Grid.Row="0" Text="Mã KH:" VerticalAlignment="Center" FontSize="15" Margin="0,10"/>
                    <TextBox x:Name="txtMaKH" Grid.Row="0" Grid.Column="1"
             Height="32" Margin="5,8"
             VerticalContentAlignment="Center"/>

                    <!-- Họ tên -->
                    <TextBlock Grid.Row="1" Text="Họ tên:" VerticalAlignment="Center" FontSize="15" Margin="0,10"/>
                    <TextBox x:Name="txtHoTen" Grid.Row="1" Grid.Column="1"
             Height="32" Margin="5,8"
             VerticalContentAlignment="Center"/>

                    <!-- SĐT -->
                    <TextBlock Grid.Row="2" Text="SĐT:" VerticalAlignment="Center" FontSize="15" Margin="0,10"/>
                    <TextBox x:Name="txtSDT" Grid.Row="2" Grid.Column="1"
             Height="32" Margin="5,8"
             VerticalContentAlignment="Center"/>
                </Grid>

                <Button Content="➕ Thêm" Style="{StaticResource ActionButtonStyle}" Click="btnThem_Click"/>
                <Button Content="🗑 Xóa" Style="{StaticResource ActionButtonStyle}" Click="btnXoa_Click"/>
                <Button Content="✏ Sửa" Style="{StaticResource ActionButtonStyle}" Click="btnSua_Click"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Danh sách khách hàng" Foreground="Red" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtTimKiem" Height="35" VerticalContentAlignment="Center" FontSize="14" Margin="0,10,133,10" Grid.ColumnSpan="2"/>

                    <Button x:Name="btnTimKiem" Content="Tìm kiếm 🔍" Style="{StaticResource ActionButtonStyle}" Margin="341,8,0,8" Grid.ColumnSpan="2" Click="btnTimKiem_Click" />
                </Grid>

                <DataGrid x:Name="dataGrid"
          Grid.Row="2"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          Background="#A6A6A6"
          RowBackground="White"
          AlternatingRowBackground="#F9F9F9"
          HeadersVisibility="Column"
          GridLinesVisibility="All"
          ColumnWidth="*"
          SelectionChanged="dataGrid_SelectionChanged"
          SelectionUnit="FullRow">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKH}"/>
                        <DataGridTextColumn Header="Họ tên" Width="2*" Binding="{Binding HoTen}"/>
                        <DataGridTextColumn Header="SĐT" Binding="{Binding SDT}"/>
                        <DataGridTextColumn Header="Mã đặt sân" Binding="{Binding MaDatSan}"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A" Margin="0,7,0,0">
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Checked="RadioButton_Checked_1">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Checked="RadioButton_Checked">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton x:Name="btnThongTin" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu"
                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="btnThongTin_Click" >
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="30" Height="30" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
            </UniformGrid>
        </Border>
    </Grid>
</Window>