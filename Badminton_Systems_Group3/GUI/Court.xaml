<Window x:Class="Badminton_Systems_Group3.GUI.Court"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Sân bãi" Height="750" Width="1200" 
        WindowState="Maximized" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#CDE8F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quản lý sân bãi" Foreground="White" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text=" 🏸" Foreground="White" FontSize="32" Margin="10,0,0,0" Width="49"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="6.5*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,20,0">
                <StackPanel Width="350">
                    <TextBlock Text="Thông tin sân bãi" Foreground="Red" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Mã sân:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtMaSan" Grid.Row="0" Grid.Column="1" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>

                        <TextBlock Grid.Row="1" Text="Tên sân:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtTenSan" Grid.Row="1" Grid.Column="1" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>

                        <TextBlock Grid.Row="2" Text="Trạng thái:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        <ComboBox x:Name="cboTrangThai" Grid.Row="2" Grid.Column="1" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="5">
                            <ComboBoxItem Content="Đang hoạt động" IsSelected="True"/>
                            <ComboBoxItem Content="Bảo trì"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Text="Giá thuê:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtGiaThue" Grid.Row="3" Grid.Column="1" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>
                    </Grid>

                    <Button x:Name="btnThem" Content="➕ Thêm sân" Style="{StaticResource ActionButtonStyle}" Click="btnThem_Click"/>
                    <Button x:Name="btnXoa" Content="🗑 Xóa sân" Style="{StaticResource ActionButtonStyle}" Click="btnXoa_Click"/>
                    <Button x:Name="btnSua" Content="✏ Sửa sân" Style="{StaticResource ActionButtonStyle}" Click="btnSua_Click"/>
                </StackPanel>
            </Viewbox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Danh sách sân bãi" Foreground="Red" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Hiển thị:" FontSize="18" Width="83" Height="21" FontWeight="Bold"/>
                        <ComboBox x:Name="cboHienThi" Width="434" Height="35" VerticalContentAlignment="Center" FontSize="16" SelectionChanged="cboHienThi_SelectionChanged" >
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="Đang hoạt động" />
                            <ComboBoxItem Content="Bảo trì"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <DataGrid x:Name="dgSanBai" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="LightGray" HeadersVisibility="Column" GridLinesVisibility="All" FontSize="16" SelectionChanged="dgSanBai_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="10"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã sân" Width="1*" Binding="{Binding MaSan}"/>
                        <DataGridTextColumn Header="Tên sân" Width="2*" Binding="{Binding TenSan}"/>
                        <DataGridTextColumn Header="Trạng thái" Width="1.5*" Binding="{Binding TrangThai}"/>
                        <DataGridTextColumn Header="Giá thuê (VND/h)" Width="1.5*" Binding="{Binding GiaThue}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="RadioButton_Checked_1" >
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="RadioButton_Checked">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>


                <RadioButton x:Name="btnThongTin" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Click="btnThongTin_Click" >
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
            </UniformGrid>
        </Border>
    </Grid>
</Window>