<Window x:Class="Badminton_Systems_Group3.GUI.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trang chủ" Height="768" Width="1002" WindowState="Maximized" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bgBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#024D2A"/>
                                <Setter TargetName="bgBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#CDE8F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Image/nen.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="180*"/>
            <RowDefinition Height="479*"/>
            <RowDefinition Height="93*"/>
        </Grid.RowDefinitions>

        <Viewbox Grid.Row="0" Margin="20,20,20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="120" Height="120" Margin="0 0 20 0">
                    <Grid.Clip>
                        <EllipseGeometry Center="60 60" RadiusX="60" RadiusY="60"/>
                    </Grid.Clip>
                    <Image Source="/Image/logo.png" Stretch="UniformToFill"/>
                </Grid>
                <TextBlock Text="BADMINTON HUB" FontSize="48" FontWeight="Black" Foreground="White" FontFamily="Cooper Black" VerticalAlignment="Center" Margin="0 15 0 0"/>
            </StackPanel>
        </Viewbox>

        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="20">
            <UniformGrid Columns="3" Rows="2" Width="1000" Height="480">
                <Button x:Name="btnSanBai" Style="{StaticResource FlatButton}" Margin="15" Click="btnSanBai_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Image/1.png" Stretch="Uniform"/>
                    </Button.Background>
                    <TextBlock Text="Quản lý&#x0a;Sân bãi" FontSize="30" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 30 0"/>
                </Button>

                <Button x:Name="btnDatSan" Style="{StaticResource FlatButton}" Margin="15" Click="btnDatSan_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Image/2.png" Stretch="Uniform"/>
                    </Button.Background>
                    <TextBlock Text="Quản lý&#x0a;Đặt sân" FontSize="30" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 30 0"/>
                </Button>

                <Button x:Name="btnKho" Style="{StaticResource FlatButton}" Margin="15" Click="btnKho_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Image/3.png" Stretch="Uniform"/>
                    </Button.Background>
                    <TextBlock Text="Quản lý Kho" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 30 0"/>
                </Button>

                <Button x:Name="btnDoanhThu" Style="{StaticResource FlatButton}" Margin="15" Click="btnDoanhThu_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Image/4.png" Stretch="Uniform"/>
                    </Button.Background>
                    <TextBlock Text="Quản lý&#x0a;Doanh thu" FontSize="30" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 30 0"/>
                </Button>

                <Button x:Name="btnKhachHang" Style="{StaticResource FlatButton}" Margin="15" Click="btnKhachHang_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Image/5.png" Stretch="Uniform"/>
                    </Button.Background>
                    <TextBlock Text="Quản lý&#x0a;Khách hàng" FontSize="30" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 30 0"/>
                </Button>

                <Button x:Name="btnBanHang" Style="{StaticResource FlatButton}" Margin="15" Click="btnBanHang_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/Image/6.png" Stretch="Uniform"/>
                    </Button.Background>
                    <TextBlock Text="Bán hàng" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 30 0"/>
                </Button>
            </UniformGrid>
        </Viewbox>

        <Grid Grid.Row="2" Background="#003D20" Margin="0,17,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="btnTrangChu" Grid.Column="0" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="btnTrangChu_Checked" >
                <Viewbox Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Image/homeicon.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Viewbox>
            </RadioButton>

            <RadioButton x:Name="btnLichDat" Grid.Column="1" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="btnLichDat_Checked" >
                <Viewbox Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Image/booking (1).png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Viewbox>
            </RadioButton>

            <RadioButton x:Name="btnThongTin" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Click="btnThongTin_Click" >
                <Viewbox Margin="10">
                    <StackPanel Orientation="Vertical">
                        <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="/Image/user1.png"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Viewbox>
            </RadioButton>
        </Grid>
    </Grid>
</Window>