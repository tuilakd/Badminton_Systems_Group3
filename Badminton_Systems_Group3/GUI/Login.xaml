<Window x:Class="Badminton_Systems_Group3.GUI.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng nhập" Height="700" Width="950" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="LoginCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Color="#55000000" Direction="315" ShadowDepth="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernInputStyle" TargetType="Control">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFAAAAAA"/>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#95BF9A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A8D0AD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Image/nen.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Viewbox Stretch="Uniform" Margin="20">
            <Grid Width="900" Height="650">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <Grid Width="160" Height="160" Margin="0,0,20,0">
                        <Grid.Clip>
                            <EllipseGeometry Center="80,80" RadiusX="80" RadiusY="80"/>
                        </Grid.Clip>
                        <Image Source="/Image/logo.png" Stretch="UniformToFill"/>
                    </Grid>
                    <TextBlock Text="BADMINTON HUB" FontSize="65" FontWeight="Black" Foreground="White" FontFamily="Cooper Black" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource LoginCardStyle}" Width="750" Padding="40,30,40,40" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Đăng nhập" FontSize="50" Foreground="DarkGreen" FontFamily="Cambria" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Image/account.png" Width="35" Height="35" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Tên đăng nhập:" FontSize="28" FontWeight="Bold" FontFamily="Candara" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="txtUsername" Style="{StaticResource ModernInputStyle}"/>
                        </Grid>

                        <Grid Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Image/padlock.png" Width="35" Height="35" Margin="0,0,15,0"/>
                            <TextBlock Grid.Column="1" Text="Mật khẩu:" FontSize="28" FontWeight="Bold" FontFamily="Candara" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="2" x:Name="txtPassword" Style="{StaticResource ModernInputStyle}"/>
                        </Grid>

                        <Button x:Name="LoginButton" Content="Đăng nhập" Style="{StaticResource LoginButtonStyle}" Click="LoginButton_Click" FontFamily="Candara"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>