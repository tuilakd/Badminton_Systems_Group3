<Window x:Class="Badminton_Systems_Group3.GUI.Revenue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Doanh thu " Height="752" Width="1613" 
        WindowState="Maximized" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9534F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,15,0,0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#CDE8F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quản lý Doanh thu" Foreground="White" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text=" 📊" Foreground="White" FontSize="32" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="81*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform" VerticalAlignment="Top" Height="517" HorizontalAlignment="Left" Width="487">
                <StackPanel Width="471">
                    <TextBlock Text="Thông tin doanh thu" Foreground="Red" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Từ ngày:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        <DatePicker Grid.Row="0" Grid.Column="1" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>

                        <TextBlock Grid.Row="1" Text="Đến ngày:" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="5"/>
                    </Grid>

                    <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="0,5,0,10" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💲" FontSize="45" Foreground="#38A169" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="TỔNG DOANH THU" FontSize="18" FontWeight="Bold" Foreground="#38A169" HorizontalAlignment="Right"/>
                                <TextBlock Text="0 VNĐ" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#F4B41A" BorderThickness="1" Background="White" Margin="0,5,0,10" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="☀️" FontSize="45" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="HÔM NAY" FontSize="18" FontWeight="Bold" Foreground="#F4B41A" HorizontalAlignment="Right"/>
                                <TextBlock Text="0 VNĐ" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#1A8CD8" BorderThickness="1" Background="White" Margin="0,5,0,15" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📅" FontSize="45" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="THÁNG NÀY" FontSize="18" FontWeight="Bold" Foreground="#1A8CD8" HorizontalAlignment="Right"/>
                                <TextBlock Text="0 VNĐ" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Content="BÁO CÁO DOANH SỐ" Style="{StaticResource ReportButtonStyle}"/>
                </StackPanel>
            </Viewbox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Bảng giao dịch" Foreground="Red" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Loại hóa đơn:" FontSize="18" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <ComboBox Width="283" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="0,0,15,0"/>
                        <TextBox Width="335" Height="36" VerticalContentAlignment="Center" FontSize="16" Margin="0,0,15,0"/>
                        <Button Content="Tìm kiếm 🔍" Style="{StaticResource ActionButtonStyle}" Height="36" Padding="15,0" Margin="0" Width="218"/>
                    </StackPanel>
                </StackPanel>

                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="LightGray" HeadersVisibility="Column" GridLinesVisibility="All" FontSize="15" Margin="0,95,0,0" Grid.RowSpan="2">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HD" Width="0.8*" Binding="{Binding MaHD}"/>
                        <DataGridTextColumn Header="Ngày lập HD" Width="1.2*" Binding="{Binding NgayLap}"/>
                        <DataGridTextColumn Header="Loại hóa đơn" Width="1.2*" Binding="{Binding LoaiHD}"/>
                        <DataGridTextColumn Header="Chi tiết" Width="2*" Binding="{Binding ChiTiet}"/>
                        <DataGridTextColumn Header="Đơn giá/Giá thuê" Width="1.5*" Binding="{Binding DonGia}"/>
                        <DataGridTextColumn Header="Số lượng" Width="0.8*" Binding="{Binding SoLuong}"/>
                        <DataGridTextColumn Header="Thành tiền" Width="1.5*" Binding="{Binding ThanhTien}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
            </UniformGrid>
        </Border>
    </Grid>
</Window>