<Window x:Class="Badminton_Systems_Group3.GUI.Sales"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bán hàng" Height="750" Width="1200" 
        WindowState="Maximized" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckoutButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#CDE8F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Bán hàng" Foreground="White" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text=" 🛒" Foreground="White" FontSize="32" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="5.5*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,-12,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Sản phẩm" Foreground="Red" FontSize="22" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="icProducts">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                                    <StackPanel>
                                        <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                            <Image Source="{Binding HinhAnh}" Stretch="Uniform" Margin="0,5,0,5"/>
                                        </Border>
                                        <TextBlock Text="{Binding TenSP}" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DonGia, StringFormat={}{0:N0} VNĐ}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                        <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                        <Button Content="➕ Thêm giỏ hàng" 
                                Click="btnAddToCart_Click" 
                                Tag="{Binding}" 
                                Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">


                    <UniformGrid Columns="2" VerticalAlignment="Top">

                        <Border x:Name="itemSP0001" BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                    <Image Source="/Image/rvvang.png" Stretch="Uniform" Margin="0,5,0,5"/>
                                </Border>
                                <TextBlock Text="Revive vàng" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="12,000 VNĐ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                <Button x:Name="btnThem1" Content="➕ Thêm giỏ hàng" Style="{StaticResource ActionButtonStyle}" Margin="5,0" Tag="SP0001" Click="btnThem_Static_Click"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="itemSP0002" BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                    <Image Source="/Image/rvtrang.png" Stretch="Uniform" Margin="0,5,0,5" />
                                </Border>
                                <TextBlock Text="Revive trắng" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="12,000 VNĐ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                <Button x:Name="btnThem2" Click="btnThem_Static_Click" Tag="SP0002" Content="➕ Thêm giỏ hàng" Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="itemSP0003" BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                    <Image Source="/Image/lavie.png" Stretch="Uniform" Margin="0,5,0,5" />
                                </Border>
                                <TextBlock Text="Nước Lavie 500ml" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="10,000 VNĐ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                <Button x:Name="btnThem3" Click="btnThem_Static_Click" Tag="SP0003" Content="➕ Thêm giỏ hàng" Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="itemSP0004" BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                    <Image Source="/Image/quancan.png" Stretch="Uniform" Margin="0,5,0,5" />
                                </Border>
                                <TextBlock Text="Quấn cán HBT" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="15,000 VNĐ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                <Button x:Name="btnThem4" Click="btnThem_Static_Click" Tag="SP0004" Content="➕ Thêm giỏ hàng" Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="itemSP0005" BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                    <Image Source="/Image/cau1.png" Stretch="Uniform" Margin="0,5,0,5"/>
                                </Border>
                                <TextBlock Text="Cầu Thành công" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="330,000 VNĐ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                <Button x:Name="btnThem5" Click="btnThem_Static_Click" Tag="SP0005" Content="➕ Thêm giỏ hàng" Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="itemSP0006" BorderBrush="#38A169" BorderThickness="1" Background="White" Margin="5" Padding="5">
                            <StackPanel>
                                <Border Height="100" Background="#F5F5F5" Margin="0,0,0,5">
                                    <Image Source="/Image/cau2.png" Stretch="Uniform" Margin="0,5,0,5"/>
                                </Border>
                                <TextBlock Text="Cầu XSMash" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="330,000 VNĐ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2"/>
                                <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="12" Foreground="DimGray" HorizontalAlignment="Right" Margin="0,0,5,5"/>
                                <Button x:Name="btnThem6" Click="btnThem_Static_Click" Tag="SP0006" Content="➕ Thêm giỏ hàng" Style="{StaticResource ActionButtonStyle}" Margin="5,0"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Column="1" Margin="0,-12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Hóa đơn" Foreground="Red" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>   
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Số lượng:" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="3" Width="70" Height="35">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="txtSoluong" Text="0" BorderThickness="0" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                    <Grid Grid.Column="1" Background="#E0E0E0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <RepeatButton x:Name="btnTang" Grid.Row="0" Content="▲" FontSize="8" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" Click="btnTang_Click"/>
                                        <RepeatButton x:Name="btnGiam" Grid.Row="1" Content="▼" FontSize="8" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" Click="btnGiam_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <Button x:Name="btnXoa" Grid.Column="1" Content="🗑 Xóa sản phẩm" Style="{StaticResource ActionButtonStyle}" Padding="15,0" Click="btnXoa_Click" Margin="331,0,0,0"/>
                    </Grid>
                </StackPanel>

                <DataGrid x:Name="dgHoaDon" SelectionChanged="dgHoaDon_SelectionChanged" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,5,0,15"
                          Background="LightGray" HeadersVisibility="Column" GridLinesVisibility="All" FontSize="16">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SP" Width="0.8*" Binding="{Binding MaSP}"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Width="2*" Binding="{Binding TenSP}"/>
                        <DataGridTextColumn Header="Đơn giá (VND)" Width="1.2*" Binding="{Binding DonGia, StringFormat={}{0:N0}}"/>
                        <DataGridTextColumn Header="Số lượng" Width="1*" Binding="{Binding SoLuong}" />
                        <DataGridTextColumn Header="Thành tiền (VND)" Width="1.5*" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Tổng tiền: " FontSize="22" FontWeight="Bold" Width="566"/>
                        <TextBlock x:Name="lblTong" Text="0 VNĐ" FontSize="22" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                    <Button x:Name="btnThanhToan" Content="THANH TOÁN VÀ IN HÓA ĐƠN 📄" Style="{StaticResource CheckoutButtonStyle}" Click="btnThanhToan_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="RadioButton_Checked_1">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>

                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="RadioButton_Checked">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>


                <RadioButton x:Name="btnThongTin" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Click="btnThongTin_Click" >
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
            </UniformGrid>
        </Border>
    </Grid>
</Window>