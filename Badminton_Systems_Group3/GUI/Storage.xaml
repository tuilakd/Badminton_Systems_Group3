<Window x:Class="Badminton_Systems_Group3.GUI.Storage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý Kho" Height="750" Width="1200" WindowState="Maximized" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#38A169"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CDE8F6"/>
                                <Setter Property="Foreground" Value="#024D2A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#CDE8F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#024D2A" Padding="20,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Quản lý Kho" Foreground="White" FontSize="32" FontWeight="Bold"/>
                <TextBlock Text=" 📦" Foreground="White" FontSize="32" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Viewbox Grid.Column="0" Stretch="Uniform" VerticalAlignment="Top" Margin="0,0,15,0">
                <StackPanel Width="220">
                    <TextBlock Text="Danh mục sản phẩm" Foreground="Red" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap"/>
                    <CheckBox Content="Revive vàng" FontSize="16" Margin="0,8"/>
                    <CheckBox Content="Revive trắng" FontSize="16" Margin="0,8"/>
                    <CheckBox Content="Nước Lavie 500ml" FontSize="16" Margin="0,8"/>
                    <CheckBox Content="Quấn cán HBT" FontSize="16" Margin="0,8"/>
                    <CheckBox Content="Cầu Thành công" FontSize="16" Margin="0,8"/>
                    <CheckBox Content="Cầu XSMash" FontSize="16" Margin="0,8"/>
                </StackPanel>
            </Viewbox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Gray" HeadersVisibility="Column" GridLinesVisibility="All" FontSize="15">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã SP" Width="1*" Binding="{Binding MaSP}"/>
                        <DataGridTextColumn Header="Tên sản phẩm" Width="2*" Binding="{Binding TenSP}"/>
                        <DataGridTextColumn Header="Đơn giá" Width="1*" Binding="{Binding DonGia}"/>
                        <DataGridTextColumn Header="Số lượng tồn" Width="1*" Binding="{Binding TonKho}"/>
                        <DataGridTextColumn Header="Ngày nhập" Width="1.2*" Binding="{Binding NgayNhap}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="1" Content="📋 Kiểm kê kho" Style="{StaticResource ActionButtonStyle}" Margin="0,15,0,0"/>
            </Grid>

            <Viewbox Grid.Column="2" Stretch="Uniform" VerticalAlignment="Top" Margin="15,0,0,0">
                <StackPanel Width="320">
                    <TextBlock Text="Cập nhật kho" Foreground="Red" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mã SP:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="1" Text="Tên SP:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="2" Text="Đơn giá:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="3" Text="Số lượng:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="5"/>
                        <TextBlock Grid.Row="4" Text="Ngày nhập:" VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <DatePicker Grid.Row="4" Grid.Column="1" Height="32" Margin="5" VerticalContentAlignment="Center"/>
                    </Grid>
                    <Button Content="➕ Nhập kho" Style="{StaticResource ActionButtonStyle}" Margin="0,20,0,0" />
                </StackPanel>
            </Viewbox>
        </Grid>

        <Border Grid.Row="2" Background="#024D2A">
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Checked="RadioButton_Checked">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/homeicon.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Trang chủ" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
                <RadioButton Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/booking (1).png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Lịch đặt" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="btnThongTin" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" GroupName="BottomMenu" Click="btnThongTin_Click">
                    <Viewbox Margin="10">
                        <StackPanel Orientation="Vertical">
                            <Rectangle Width="30" Height="30" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="/Image/user1.png"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="Thông tin" FontSize="16" Margin="0 5 0 0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </RadioButton>
            </UniformGrid>
        </Border>
    </Grid>
</Window>